# 复制为 .env 后按需修改：cp .env.example .env
# 这个文件不会进仓库（.gitignore 已排除），密钥放这里比放 json 安全

# ---------- 服务 ----------
PORT=5178
# 容器内必须是 0.0.0.0，否则端口映射进不来；本机跑可留空（默认 127.0.0.1）
HOST=0.0.0.0

# ---------- 访问控制 ----------
# 留空 = 任何人拿到链接都能浏览（默认行为，适合分享给朋友）
# 设置了 = 整站需要 HTTP Basic Auth 口令（用户名随便填，密码用这个值）
ACCESS_PASSWORD=

# ---------- 大模型 ----------
# 填了就会「锁定」：网页设置页对应字段变灰，接口也改不动
# 不填则沿用 config/settings.json 或网页里保存的值
API_KEY=
# 例：https://api.deepseek.com / https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_URL=
# 例：deepseek-chat / qwen-plus
MODEL=
# 并发数 1-8，建议 2-4
CONCURRENCY=

# ---------- 数据与浏览器 ----------
# 数据根目录，容器里由 compose 挂载到 /app/data，一般不用改
# DATA_DIR=/app/data
# 浏览器可执行文件；镜像里已装 chromium，一般不用改
# CHROME_PATH=/usr/bin/chromium
# 服务端回连自己用的地址（导出 PDF 时 Chrome 要访问它），一般不用改
# SELF_URL=http://127.0.0.1:5178

# ---------- 调试开关 ----------
# 1 = 打开 /api/debug/*（期号扫描调试），默认关闭
ENABLE_DEBUG=0
# 1 = 把抓回来的原始 HTML 也对外托管（含第三方脚本，默认关闭）
ENABLE_RAW=0
